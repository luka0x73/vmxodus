#!/usr/bin/env bash
# vmxodus - migrate VMware VMs to Proxmox VE with minimal downtime.
#
# The VM data already sits on an NFS share mounted on ESXi and PVE (moved
# there via Storage vMotion). vmxodus builds the PVE VM from the .vmx,
# renames the raw flat files into the PVE image layout and attaches them.
# No disk data is ever copied, converted or deleted.
set -euo pipefail
shopt -s nullglob inherit_errexit

readonly EXIT_ERROR=1
readonly EXIT_USAGE=2
readonly EXIT_LOCKED=3

readonly DESCRIPTOR_MAX_BYTES=65536
readonly WAIT_INTERVAL=5
readonly WAIT_DEFAULT_TIMEOUT=600

VMXODUS_CONF="${VMXODUS_CONF:-/etc/vmxodus.conf}"

DRY_RUN=0
ASSUME_YES=0

# Logging, see start_log / stop_log.
LOG_PATH=""
LOG_ORIG_OUT=""   # fd of the original stdout while logging
LOG_ORIG_ERR=""   # fd of the original stderr while logging
LOG_PIDS=()       # tee processes

# Exit handling, see install_traps.
EXIT_HOOK=""      # function called with the exit code before exit
ERR_INFO=""       # last failed command, set by the ERR trap
CAUGHT_SIGNAL=""

# Progress of cutover, reported by cutover_report on any abnormal exit.
CUTOVER_VM=""
CUTOVER_STEP=""
CUTOVER_ROLLBACK=""
CUTOVER_MOVED=0
CUTOVER_ATTACHED=0
CUTOVER_PENDING=()  # src and dst of a mv not yet recorded in the rollback file

# Parsed .vmx, keys lowercased.
declare -gA VMX=()
KV_KEY=""
KV_VALUE=""

# Derived VM config, filled by derive_config.
CFG_NAME=""
CFG_CORES=""
CFG_SOCKETS=""
CFG_MEMORY=""
CFG_BIOS=""
CFG_EFI=0
CFG_SECUREBOOT=0
CFG_OSTYPE=""
CFG_OSTYPE_WARNING=""

# Disks in target order, filled by resolve_disks.
DISK_DEVS=()      # vmx device, e.g. scsi0:1
DISK_DESCS=()     # descriptor path
DISK_SOURCES=()   # flat file path
DISK_SLOTS=()     # PVE slot, e.g. scsi1
DISK_TARGETS=()   # target file name, e.g. vm-100-disk-1.raw

# State of one VM, see state_load / state_save.
VMID=""
NODE=""
STATUS=""
PREPARED_AT=""
MIGRATED_AT=""

THIS_NODE="${HOSTNAME%%.*}"

# NICs from the .vmx, filled by vmx_nics, and their assignment.
NIC_IDXS=()
NIC_MACS=()
NIC_KEYS=()
NIC_BRIDGES=()
NIC_TAGS=()
NIC_LABELS=()
BRIDGES=()        # bridges on this node

# Options for qm create, filled by build_create_opts. Keys in qm create
# order, values and their origin (vmx, config, EXTRA_OPTS, set).
OPT_KEYS=()
declare -gA OPT_VALUES=()
declare -gA OPT_SOURCES=()

# Per-VM choices, persisted in the state file.
VM_DISK_BUS=""    # scsi, sata or virtio
SET_OPTS=()       # key=value from --set and the interactive prompt

# Keys that cannot be set via EXTRA_OPTS, --set or the prompt.
readonly RESERVED_OPT_RE='^((scsi|sata|virtio|ide)[0-9]+|boot|bios|efidisk0|vmid)$'

# Result of map_lookup.
MAP_BRIDGE=""
MAP_TAG=""
MAP_LABEL=""

# ---------------------------------------------------------------------------
# Output helpers
# ---------------------------------------------------------------------------

info() { printf '%s\n' "$*" >&2; }
warn() { printf 'WARNING: %s\n' "$*" >&2; }

# die <message> [exit code]
die() {
  printf 'ERROR: %s\n' "$1" >&2
  exit "${2:-$EXIT_ERROR}"
}

usage_error() {
  printf 'ERROR: %s\n' "$1" >&2
  usage >&2
  exit "$EXIT_USAGE"
}

usage() {
  cat <<'EOF'
Usage:
  vmxodus list
  vmxodus prepare <vm> [--vmid=<id>] [--disk-bus=<bus>] [--set key=value]...
                       [--yes] [--dry-run]
  vmxodus cutover <vm> [--start] [--wait[=<seconds>]] [--yes] [--dry-run]
  vmxodus reset <vm> [--yes] [--dry-run]

<vm> is the VM folder name on the NFS share.

Commands:
  list      Show all VM folders on the share and their migration status.
  prepare   Create the PVE VM from the .vmx while the VM still runs in VMware.
  cutover   After shutdown in vCenter, move the flat files into place and
            attach them to the PVE VM.
  reset     Undo prepare for a VM whose flat files were not moved: archive
            its state and rollback file. Prints the qm destroy hint for the
            empty PVE VM, does not run it.

Options:
  --vmid=<id>        Use this VMID instead of the next free one.
  --disk-bus=<bus>   Disk bus scsi, sata or virtio (default DISK_BUS).
  --set key=value    Extra qm create option --key value, repeatable. Wins
                     over config and .vmx values.
  --yes              Do not ask for confirmation.
  --dry-run          Print mutating commands instead of running them.
  --start            Start the VM after cutover.
  --wait[=<seconds>] Wait for VMware locks to disappear (default 600s).

Configuration: /etc/vmxodus.conf, see vmxodus.conf.example for all keys.
NFS_STORE is required.
EOF
}

# quote_cmd <arg>...: render a command line, quoting only where needed.
quote_cmd() {
  local arg out=""
  for arg in "$@"; do
    if [[ ! "$arg" =~ ^[A-Za-z0-9_./:=,@%+-]+$ ]]; then
      arg="'${arg//\'/\'\\\'\'}'"
    fi
    out+="${out:+ }$arg"
  done
  printf '%s' "$out"
}

# run <cmd> [arg]...: the single entry point for every mutating command.
# Prints the command, runs it unless --dry-run.
run() {
  if ((DRY_RUN)); then
    printf '[dry-run] %s\n' "$(quote_cmd "$@")"
  else
    printf '+ %s\n' "$(quote_cmd "$@")"
    "$@"
  fi
}

# write_atomic <file> <content>: write via temp file in the same directory.
write_atomic() {
  local file=$1 content=$2 tmp
  tmp=$(mktemp "$file.XXXXXX")
  printf '%s' "$content" > "$tmp"
  mv -f "$tmp" "$file"
}

# append_line <file> <line>
append_line() {
  printf '%s\n' "$2" >> "$1"
}

# start_log <vm> <args>...: append all further output to <vm>.log. The
# original stdout/stderr are kept on separate fds, so stop_log can restore
# them and messages can bypass tee when it is gone.
start_log() {
  local vm=$1
  shift
  ((DRY_RUN)) && return 0
  LOG_PATH=$(log_file "$vm")
  exec {LOG_ORIG_OUT}>&1 {LOG_ORIG_ERR}>&2
  exec > >(tee -a "$LOG_PATH" >&"$LOG_ORIG_OUT")
  LOG_PIDS+=("$!")
  exec 2> >(tee -a "$LOG_PATH" >&"$LOG_ORIG_ERR")
  LOG_PIDS+=("$!")
  printf '=== %s node %s: vmxodus %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$THIS_NODE" "$*"
}

# restore_output: point stdout/stderr back to the originals, bypassing tee.
restore_output() {
  ((${#LOG_PIDS[@]})) || return 0
  exec 1>&"$LOG_ORIG_OUT" 2>&"$LOG_ORIG_ERR"
}

# stop_log: restore the original stdout/stderr and wait until the tee
# processes have written everything, so no output arrives after exit.
stop_log() {
  ((${#LOG_PIDS[@]})) || return 0
  restore_output
  wait "${LOG_PIDS[@]}" 2> /dev/null || true
  LOG_PIDS=()
}

# report <line>: print to the original stderr and append to the log
# directly, so it arrives even when the tee processes are gone.
report() {
  printf '%s\n' "$1" >&2 2> /dev/null || true
  if [[ -n "$LOG_PATH" ]]; then
    printf '%s\n' "$1" >> "$LOG_PATH" 2> /dev/null || true
  fi
}

on_err() {
  ERR_INFO="'$3' failed with exit code $1 at line $2"
}

# on_signal <name> <exit code>: a dead tee means every further write raises
# SIGPIPE again, which would abort the exit path before on_exit ran. So
# ignore SIGPIPE and leave the tee pipes before calling exit.
on_signal() {
  trap '' PIPE
  [[ -n "$CAUGHT_SIGNAL" ]] || CAUGHT_SIGNAL=$1
  restore_output
  exit "$2"
}

on_exit() {
  local rc=$?
  trap '' PIPE
  trap - ERR
  set +e
  stop_log
  if [[ -n "$EXIT_HOOK" ]]; then
    "$EXIT_HOOK" "$rc"
  fi
  exit "$rc"
}

# install_traps: record failed commands, turn fatal signals into a normal
# exit and always run on_exit, so vmxodus never dies silently.
install_traps() {
  set -E
  trap 'on_err "$?" "$LINENO" "$BASH_COMMAND"' ERR
  trap on_exit EXIT
  trap 'on_signal HUP 129' HUP
  trap 'on_signal INT 130' INT
  trap 'on_signal PIPE 141' PIPE
  trap 'on_signal TERM 143' TERM
}

# ask <prompt>: prompt on stderr, print the answer on stdout.
ask() {
  local answer
  printf '%s' "$1" >&2
  IFS= read -r answer || die "no input on stdin"
  printf '%s' "$answer"
}

# confirm <question>: default no.
confirm() {
  local answer
  answer=$(ask "$1 [y/N] ") || exit
  [[ "${answer,,}" == "y" || "${answer,,}" == "yes" ]]
}

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------

load_config() {
  NFS_STORE=""
  NFS_PATH=""
  STATE_DIR=""
  CPU_TYPE="x86-64-v2-AES"
  NUMA="1"
  HOTPLUG="disk,network,usb"
  SCSIHW="virtio-scsi-single"
  DISK_OPTS="discard=on,iothread=1,ssd=1"
  DISK_BUS="scsi"
  NIC_MODEL="virtio"
  DEFAULT_BRIDGE="vmbr0"
  CDROM_SLOT="ide0"
  EFI_STORE=""
  AGENT="1"
  EXTRA_OPTS=()

  if [[ -f "$VMXODUS_CONF" ]]; then
